#!/bin/bash
# Pull changes from all git repositories in current or specified directory

TARGET_DIR="${1:-.}"

if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist"
    exit 1
fi

echo "Pulling changes from all repos in: $TARGET_DIR"
echo "=================================================="

cd "$TARGET_DIR" || exit 1

PULLED=0
FAILED=0
SKIPPED=0

for repo in */; do
    if [ -d "$repo/.git" ]; then
        echo ""
        echo "📦 $repo"
        cd "$repo" || continue

        if git pull; then
            ((PULLED++))
        else
            echo "❌ Failed to pull $repo"
            ((FAILED++))
        fi

        cd .. || exit 1
    else
        ((SKIPPED++))
    fi
done

echo ""
echo "=================================================="
echo "Summary: $PULLED pulled | $FAILED failed | $SKIPPED skipped"
