{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git/**)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/target/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(**/*.lock)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "editorMode": "vim"
}
